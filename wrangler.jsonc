{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kjdfksjdfkjsdfkjshdfjk",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/analytics"]
  },
  "d1_databases": [{
    "binding": "ANALYTICS",
    "database_name": "kjdfksjdfkjsdfkjshdfjk-analytics",
    "database_id": "5f26b8e0-2b82-4e4d-a68c-8414ef54a558",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
