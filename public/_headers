# Only content-hashed derivatives are immutable. Originals and HTML revalidate.
/assets/generated/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.wasm
  Cache-Control: public, max-age=31536000, immutable
